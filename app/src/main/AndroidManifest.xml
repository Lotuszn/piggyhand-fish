<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.piggyhand.fish">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 11+ 包可见性：需要查闲鱼的 uid / 版本，不加这段 getPackageInfo 直接抛 NameNotFound -->
    <queries>
        <package android:name="com.taobao.idlefish" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@drawable/fish_logo"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:allowBackup="true">

        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription" android:value="@string/module_desc" />
        <meta-data android:name="xposedminversion" android:value="82" />
        <meta-data android:name="xposedscope" android:resource="@array/xposed_scope" />

        <!-- 配置界面本身不再挂 LAUNCHER，只留显式启动；桌面图标由下面的 alias 承载，
             这样运行时能单独禁用 alias 把图标藏起来，而不影响界面被拉起 -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <!-- LSPosed 管理器模块页右下角那个「启动」按钮靠这个 category 认入口：
                 AppHelper.getSettingsIntent 第一优先级查 MODULE_SETTINGS，查不到才退回
                 CATEGORY_INFO / CATEGORY_LAUNCHER。必须挂在 <activity> 上而不是 alias 上，
                 否则 alias 一旦被禁用，按钮会跟着消失（隐藏图标后就没法从 LSPosed 进界面了）。
                 桌面只认 CATEGORY_LAUNCHER，所以这条不会多出图标。 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".LauncherAlias"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@drawable/fish_logo"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
